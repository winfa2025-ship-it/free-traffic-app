# Set these to create your admin login (seeded on first run)
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=
# If ADMIN_PASSWORD left empty, a random password is generated and printed at startup.
# Set a strong one for production.

# Secret for session cookies (use a long random string)
TOKEN_SECRET=change-me-to-a-long-random-string

# Optional super-admin header key (bypasses login). Leave empty to require login.
ADMIN_KEY=

PORT=3000
