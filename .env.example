# Set these to create your admin login (seeded on first run)
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=
# If ADMIN_PASSWORD left empty, a random password is generated and printed at startup.
# Set a strong one for production.

# Secret for session cookies. If left as the default/empty, a random secret is
# generated and persisted to data/.secret. For production set a long random string
# here so sessions survive redeploys.
TOKEN_SECRET=change-me-to-a-long-random-string

# Registration: leave REGISTER_CODE empty to DISABLE public signup (recommended).
# Set it to an invite code to allow new admins to register via /register.
REGISTER_CODE=

# Send session cookies with Secure flag (HTTPS only). Set to false for local HTTP dev.
SECURE_COOKIE=true

# Optional super-admin header key (bypasses login). Leave empty to require login.
ADMIN_KEY=

PORT=3000
